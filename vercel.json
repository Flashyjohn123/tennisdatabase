{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/proxy/espn-tennis",
      "destination": "https://www.espn.com/espn/rss/tennis/news"
    },
    {
      "source": "/api/proxy/atp-tour",
      "destination": "https://www.atptour.com/en/media/rss/news"
    },
    {
      "source": "/api/proxy/wta-tennis",
      "destination": "https://www.wtatennis.com/rss"
    },
    {
      "source": "/api/proxy/espn-scores-atp",
      "destination": "https://site.api.espn.com/apis/site/v2/sports/tennis/atp/scoreboard"
    },
    {
      "source": "/api/proxy/espn-scores-wta",
      "destination": "https://site.api.espn.com/apis/site/v2/sports/tennis/wta/scoreboard"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
